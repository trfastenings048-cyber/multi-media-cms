{
  "name": "tr-fastenings-screen-player",
  "productName": "XOS",
  "version": "1.0.0",
  "description": "Full-screen kiosk player that shows the content assigned to a TR Fastenings Multimedia screen.",
  "main": "main.js",
  "private": true,
  "author": "TR Fastenings",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never",
    "test:navigation": "electron navigation-check.js",
    "release": "npm run test:navigation && npm run dist && electron navigation-check.js --packaged && node publish-build.js"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.trfastenings.screenplayer",
    "productName": "XOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "navigation.js",
      "navigation-preload.js",
      "navigation-renderer.js",
      "navigation.html",
      "preload.js",
      "overlay.html",
      "player.html",
      "build-config.json",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "portable",
      "artifactName": "ScreenPlayer.exe"
    }
  },
  "dependencies": {
    "ably": "^2.29.0"
  }
}
